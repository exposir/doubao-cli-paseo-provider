{
  "name": "doubao-cli-paseo-provider",
  "version": "0.1.0",
  "description": "Doubao CLI provider plugin for Paseo: streaming turns, resume, dynamic model catalogue",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "paseo-plugin.json",
    "icon.png",
    "icon.svg",
    "index.server.ts",
    "server/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "scripts/",
    "docs/",
    "tsconfig.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "test:live": "tsc -p tsconfig.json && DOUBAO_LIVE=1 node --test dist/test/*.test.js",
    "e2e": "bash scripts/e2e.sh",
    "e2e:draw": "bash scripts/e2e-drawing.sh",
    "soak": "bash scripts/soak.sh",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "pretest": "npm run clean",
    "scenarios": "bash scripts/scenarios.sh"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.17.6",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "author": "exposir",
  "repository": {
    "type": "git",
    "url": "https://github.com/exposir/doubao-cli-paseo-provider.git"
  },
  "homepage": "https://github.com/exposir/doubao-cli-paseo-provider",
  "bugs": {
    "url": "https://github.com/exposir/doubao-cli-paseo-provider/issues"
  },
  "keywords": [
    "paseo",
    "paseo-plugin",
    "doubao",
    "doubao-cli",
    "agent",
    "provider",
    "stream-json"
  ]
}
